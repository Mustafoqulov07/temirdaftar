# Server port (Railway o'zi o'rnatadi)
PORT=3000

# Frontend manzili (CORS uchun)
FRONTEND_URL="http://localhost:5173"

# Telegram bot token (ixtiyoriy — @BotFather dan oling)
TELEGRAM_BOT_TOKEN=""

# Super Admin hisobi (sozlanmagan bo'lsa, bazada admin bo'lmasa hech kim admin bo'lmaydi!)
