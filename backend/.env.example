# PostgreSQL baza URL (Neon.tech dan oling)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# JWT maxfiy kalit (uzun va tasodifiy qiling)
JWT_SECRET="sizning-maxfiy-kalitingiz-bu-yerda"

# Refresh token uchun alohida maxfiy kalit (JWT_SECRET bilan bir xil bo'lmasin)
